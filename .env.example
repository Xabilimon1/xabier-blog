# GitHub OAuth App credentials for Decap CMS.
# Create the OAuth App at: https://github.com/settings/developers → New OAuth App
#   - Application name: xabier-blog CMS
#   - Homepage URL:    https://xabier-blog.vercel.app
#   - Authorization callback URL: https://xabier-blog.vercel.app/api/callback
# Copy the Client ID + generate a Client Secret, then:
#   vercel env add OAUTH_GITHUB_CLIENT_ID production
#   vercel env add OAUTH_GITHUB_CLIENT_SECRET production
# (Use the same vars in `development` + `preview` if you also want to use the
# CMS locally / on previews.)

OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
