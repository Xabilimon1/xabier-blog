---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { isoDate } from "../../lib/format";

const all = (await getCollection("posts", ({ data }) => !data.draft && data.lang === "en"))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());


const blogJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    "@id": "https://xabier.me/en/blog#blog",
    url: "https://xabier.me/en/blog",
    name: "Blog — Xabier Ariznabarreta",
    inLanguage: "en-US",
    author: { "@id": "https://xabier.me/#person" },
    publisher: { "@id": "https://xabier.me/#person" },
    description: "Public research notebook. Notes on LLM evals, mech interp, agent harnesses, and production lessons.",
    blogPost: all.slice(0, 5).map((p) => ({
      "@type": "BlogPosting",
      "@id": `https://xabier.me/posts/${p.id}#article`,
      headline: p.data.title,
      url: `https://xabier.me/posts/${p.id}`,
      datePublished: p.data.publishedAt.toISOString(),
      description: p.data.excerpt,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Xabier Ariznabarreta", item: "https://xabier.me" },
      { "@type": "ListItem", position: 2, name: "Blog", item: "https://xabier.me/en/blog" },
    ],
  },
];
---

<Layout
  title="Blog — Xabier Ariznabarreta"
  description="Public research notebook. Notes on LLM evals, mech interp, agent harnesses, and production lessons."
  current="blog"
  lang="en"
  alternates={[
    { hreflang: "en", href: "https://xabier.me/en/blog" },
    { hreflang: "es", href: "https://xabier.me/blog" },
    { hreflang: "x-default", href: "https://xabier.me/en/blog" },
  ]}
  jsonLd={blogJsonLd}
>
  <h1 class="page-title">Blog</h1>
  <p class="lead">
    Public research notebook. All posts, chronological.
     <a class="lang-toggle" href="/blog">Español</a>
  </p>

  {all.length === 0 ? (
    <p class="empty">
      No English posts yet. Everything is in Spanish at <a href="/blog">/blog</a>. Translations follow.
    </p>
  ) : (
    <ul class="log">
      {all.map((post) => (
        <li>
          <time datetime={post.data.publishedAt.toISOString()}>{isoDate(post.data.publishedAt)}</time>
          <div>
            <a class="log-title" href={`/posts/${post.id}`}>{post.data.title}</a>
            <p class="log-excerpt">{post.data.excerpt}</p>
          </div>
        </li>
      ))}
    </ul>
  )}
</Layout>
