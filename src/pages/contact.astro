---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact — Xabier Ariznabarreta" current="contact">

  <h2 class="section-heading">Get In Touch</h2>

  <div class="contact-grid" style="margin-top: 28px;">
    <div class="contact-intro">
      <h2>Let's talk.</h2>
      <p>Best reasons to write: a draft you want feedback on, a question about something I posted, a research collaboration, or a typo on the site. Worst reasons: cold sales pitches and crypto schemes — I've already shipped one fake token by accident, I don't need a real one.</p>
      <p>The fastest path is <a href="mailto:xabier.ariznabarreta@gmail.com">email</a>.</p>

      <div class="contact-details">
        <div class="contact-row">
          <div class="ico">
            <iconify-icon icon="ph:envelope-simple" width="20" height="20"></iconify-icon>
          </div>
          <div>
            <div class="lbl">Email</div>
            <div class="val"><a href="mailto:xabier.ariznabarreta@gmail.com">xabier.ariznabarreta@gmail.com</a></div>
          </div>
        </div>
        <div class="contact-row">
          <div class="ico">
            <iconify-icon icon="ph:github-logo-fill" width="20" height="20"></iconify-icon>
          </div>
          <div>
            <div class="lbl">GitHub</div>
            <div class="val"><a href="https://github.com/Xabilimon1" target="_blank" rel="noopener">@Xabilimon1</a></div>
          </div>
        </div>
        <div class="contact-row">
          <div class="ico">
            <iconify-icon icon="ph:map-pin" width="16" height="16"></iconify-icon>
          </div>
          <div>
            <div class="lbl">Based in</div>
            <div class="val">Madrid, Spain</div>
          </div>
        </div>
      </div>
    </div>

    <form
      class="form-grid"
      action="https://formspree.io/f/REPLACE_ME_FORMSPREE_ID"
      method="POST"
    >
      <div class="field">
        <label for="f-name">Your name</label>
        <input id="f-name" name="name" type="text" placeholder="Jane Doe" required />
      </div>
      <div class="field">
        <label for="f-email">Email address</label>
        <input id="f-email" name="email" type="email" placeholder="jane@example.com" required />
      </div>
      <div class="field full">
        <label for="f-subject">Subject</label>
        <input id="f-subject" name="subject" type="text" placeholder="Feedback on the harness-ablation draft" />
      </div>
      <div class="field full">
        <label for="f-message">Message</label>
        <textarea id="f-message" name="message" placeholder="Write your message here…" required></textarea>
      </div>
      <div class="field full">
        <p style="font-size:12px; color:var(--ink-400); margin: 0 0 12px;">
          Form delivery isn't wired yet — until I paste a <a href="https://formspree.io" target="_blank" rel="noopener">Formspree</a> ID above, please use email directly.
        </p>
        <button type="submit" class="btn-pill">
          Send message
          <iconify-icon icon="ph:arrow-right" width="14" height="14"></iconify-icon>
        </button>
      </div>
    </form>
  </div>

</Layout>
