---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Resume — Xabier Ariznabarreta" current="resume">

  <div class="about-page-hero">
    <div class="portrait-large" style="background: var(--coral);">
      <iconify-icon icon="ph:briefcase-fill" width="96" height="96" style="color:#fff"></iconify-icon>
    </div>
    <div>
      <div class="kicker">Resume</div>
      <h1>Education &amp; experience.</h1>
      <p>Currently studying AI Engineering in Madrid while shipping production agents and starting empirical research. The short version below — the long version is on the <a href="/about" style="color:var(--coral);">about page</a>.</p>
    </div>
  </div>

  <section class="section" id="resume">
    <div class="resume-grid">

      <div class="resume-col">
        <h3>
          <iconify-icon icon="ph:graduation-cap" width="18" height="18"></iconify-icon>
          Education
        </h3>
        <ol class="timeline">
          <li class="tl-item">
            <div class="tl-when">2024 — Present</div>
            <div class="tl-title">BSc, AI Engineering</div>
            <div class="tl-where">Universidad Francisco de Vitoria, Madrid</div>
            <div class="tl-body">Second-year undergrad in Sistemas de Inteligencia Artificial. Focus on representation learning, optimization, and applied research.</div>
          </li>
          <li class="tl-item" data-dot="purple">
            <div class="tl-when">2026 — In progress</div>
            <div class="tl-title">ARENA — Alignment curriculum</div>
            <div class="tl-where">Self-paced</div>
            <div class="tl-body">Working through transformer internals, mech interp, and RL chapters to bridge from builder to researcher.</div>
          </li>
          <li class="tl-item" data-dot="mint">
            <div class="tl-when">2022 — 2024</div>
            <div class="tl-title">Bachillerato — Science track</div>
            <div class="tl-where">Bilbao, Spain</div>
            <div class="tl-body">Started building agents on the side while finishing high school.</div>
          </li>
        </ol>
      </div>

      <div class="resume-col">
        <h3>
          <iconify-icon icon="ph:briefcase" width="18" height="18"></iconify-icon>
          Experience
        </h3>
        <ol class="timeline">
          <li class="tl-item">
            <div class="tl-when">2025 — Present</div>
            <div class="tl-title">Research-in-training</div>
            <div class="tl-where">Independent — harness-ablation paper</div>
            <div class="tl-body">Designing and running an empirical ablation study of agent-harness components. Hypotheses, design choices and null findings are posted here as research notes.</div>
          </li>
          <li class="tl-item" data-dot="yellow">
            <div class="tl-when">2024 — Present</div>
            <div class="tl-title">Production AI engineer</div>
            <div class="tl-where">Freelance &amp; institutional</div>
            <div class="tl-body">Shipping agentic systems end-to-end: Salesforce-integrated commercial agents, MCP servers with security-review loops, Android field assistants, multilingual institutional tooling.</div>
          </li>
          <li class="tl-item" data-dot="purple">
            <div class="tl-when">2024</div>
            <div class="tl-title">First production agent</div>
            <div class="tl-where">University project → real deployment</div>
            <div class="tl-body">Built and shipped the first commercial agent. Lessons (including the painful ones) will appear in the blog as posts ship.</div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section">
    <h2 class="section-heading">Skills</h2>
    <div class="about-skills" style="max-width: 560px;">
      <div class="skill" data-color="orange">
        <div class="skill-head"><span>Production agents</span><span class="pct">85%</span></div>
        <div class="skill-track"><div class="skill-bar" style="width:85%"></div></div>
      </div>
      <div class="skill" data-color="mint">
        <div class="skill-head"><span>LLM research</span><span class="pct">55%</span></div>
        <div class="skill-track"><div class="skill-bar" style="width:55%"></div></div>
      </div>
      <div class="skill" data-color="red">
        <div class="skill-head"><span>Mech interp</span><span class="pct">35%</span></div>
        <div class="skill-track"><div class="skill-bar" style="width:35%"></div></div>
      </div>
      <div class="skill" data-color="blue">
        <div class="skill-head"><span>Eval methodology</span><span class="pct">50%</span></div>
        <div class="skill-track"><div class="skill-bar" style="width:50%"></div></div>
      </div>
      <div class="skill" data-color="purple">
        <div class="skill-head"><span>Python / PyTorch</span><span class="pct">75%</span></div>
        <div class="skill-track"><div class="skill-bar" style="width:75%"></div></div>
      </div>
    </div>
  </section>

  <div class="foot-note">
    Want the long version? <a href="/about">Read about me</a>, or <a href="/contact">get in touch</a>.
  </div>

</Layout>
