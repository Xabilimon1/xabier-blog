---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { categoryLabel, isoDate } from "../lib/format";

const all = (await getCollection("posts", ({ data }) => !data.draft && data.lang === "es"))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());


const blogJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    "@id": "https://xabier.me/blog#blog",
    url: "https://xabier.me/blog",
    name: "Blog — Xabier Ariznabarreta",
    inLanguage: "es-ES",
    author: { "@id": "https://xabier.me/#person" },
    publisher: { "@id": "https://xabier.me/#person" },
    description: "Cuaderno público de research. Notas sobre LLM evals, mech interp, agent harnesses y lecciones de producción.",
    blogPost: all.slice(0, 5).map((p) => ({
      "@type": "BlogPosting",
      "@id": `https://xabier.me/posts/${p.id}#article`,
      headline: p.data.title,
      url: `https://xabier.me/posts/${p.id}`,
      datePublished: p.data.publishedAt.toISOString(),
      description: p.data.excerpt,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Xabier Ariznabarreta", item: "https://xabier.me" },
      { "@type": "ListItem", position: 2, name: "Blog", item: "https://xabier.me/blog" },
    ],
  },
];
---

<Layout
  title="Blog — Xabier Ariznabarreta"
  description="Cuaderno público de research. Notas sobre LLM evals, mech interp, agent harnesses y lecciones de producción."
  current="blog"
  lang="es"
  alternates={[
    { hreflang: "es", href: "https://xabier.me/blog" },
    { hreflang: "en", href: "https://xabier.me/en/blog" },
    { hreflang: "x-default", href: "https://xabier.me/en/blog" },
  ]}
  jsonLd={blogJsonLd}
>
  <h1 class="page-title">Blog</h1>
  <p class="lead">
    Cuaderno público de research. Todos los posts, cronológicos.
     <a class="lang-toggle" href="/en/blog">English</a>
  </p>

  {all.length === 0 ? (
    <p class="empty">
      El primer post está en el horno. Suscríbete al <a href="/rss.xml">RSS</a>.
    </p>
  ) : (
    <ul class="log">
      {all.map((post) => (
        <li>
          <time datetime={post.data.publishedAt.toISOString()}>{isoDate(post.data.publishedAt)}</time>
          <div>
            <p class="log-kicker">{categoryLabel(post.data.category, "es")}</p>
            <a class="log-title" href={`/posts/${post.id}`}>{post.data.title}</a>
            <p class="log-excerpt">{post.data.excerpt}</p>
          </div>
        </li>
      ))}
    </ul>
  )}
</Layout>
