---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const all = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const dateFmt = (d: Date) =>
  new Intl.DateTimeFormat("en-GB", { day: "2-digit", month: "short", year: "numeric" }).format(d);

const categoryLabel = (c: string) =>
  c === "tech" ? "Tech" : c === "research" ? "Research" : c === "production" ? "Production" : "Meta";
---

<Layout title="Blog — Xabier Ariznabarreta" current="blog">

  <h2 class="section-heading">Blog</h2>
  <p style="color:var(--ink-500); margin: -8px 0 28px; font-size: 14.5px; max-width: 640px;">
    A public research notebook. Four kinds of posts: technical deep-dives, research notes, production lessons, and meta-journey reflections.
  </p>

  <div class="chip-row">
    <button class="chip" data-cat="all" aria-pressed="true">All</button>
    <button class="chip" data-cat="tech">Tech deep-dive</button>
    <button class="chip" data-cat="research">Research notes</button>
    <button class="chip" data-cat="production">Production</button>
    <button class="chip" data-cat="meta">Meta</button>
  </div>

  {all.length === 0 ? (
    <div class="card" style="padding:48px 32px; text-align:center; margin-top:8px;">
      <iconify-icon icon="ph:notebook" width="48" height="48" style="color:var(--ink-300);"></iconify-icon>
      <h3 style="margin:16px 0 8px;">No posts yet</h3>
      <p style="color:var(--ink-500); max-width:420px; margin:0 auto;">
        The notebook is empty by design. First post lands soon. Until then, you can read the <a href="/about">about page</a> or follow <a href="https://github.com/Xabilimon1" target="_blank" rel="noopener">@Xabilimon1</a> on GitHub.
      </p>
    </div>
  ) : (
    <div class="posts">
      {all.map((post) => (
        <a href={`/posts/${post.slug}`} class="post-card" data-cat={post.data.category}>
          <div class="post-cover" data-c={post.data.color}>
            <iconify-icon icon={post.data.icon} width="36" height="36"></iconify-icon>
          </div>
          <div>
            <div class="post-meta">
              <span class="badge" data-c={post.data.color}>{categoryLabel(post.data.category)}</span>
              <span>{dateFmt(post.data.publishedAt)}</span>
              <span>· {post.data.readingMinutes} min read</span>
            </div>
            <h3 class="post-title">{post.data.title}</h3>
            <p class="post-excerpt">{post.data.excerpt}</p>
          </div>
          <div class="post-arrow">
            <iconify-icon icon="ph:arrow-right" width="14" height="14"></iconify-icon>
          </div>
        </a>
      ))}
    </div>
  )}

  <div class="foot-note">
    Want to discuss anything? <a href="/contact">Send me a note.</a>
  </div>

  <script is:inline>
    const chips = document.querySelectorAll('.chip');
    const cards = document.querySelectorAll('.post-card');

    function applyFilter(cat) {
      cards.forEach(card => {
        const match = (cat === 'all') || (card.dataset.cat === cat);
        card.classList.toggle('is-hidden', !match);
      });
    }

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        chips.forEach(c => c.setAttribute('aria-pressed', 'false'));
        chip.setAttribute('aria-pressed', 'true');
        applyFilter(chip.dataset.cat);
      });
    });
  </script>

</Layout>
