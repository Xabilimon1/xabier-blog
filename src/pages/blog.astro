  <script is:inline src="https://code.iconify.design/iconify-icon/2.0.0/iconify-icon.min.js"></script>
  <script src="/doodles.js" is:inline></script>
  <script src="/animations.js" is:inline></script>
  <script is:inline>
    // Chip filter: show only post-cards whose data-cat matches the active chip.
    const chips = document.querySelectorAll('.chip');
    const cards = document.querySelectorAll('.post-card');

    function applyFilter(cat) {
      cards.forEach(card => {
        const match = (cat === 'all') || (card.dataset.cat === cat);
        card.classList.toggle('is-hidden', !match);
      });
    }

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        chips.forEach(c => c.setAttribute('aria-pressed', 'false'));
        chip.setAttribute('aria-pressed', 'true');
        applyFilter(chip.dataset.cat);
      });
    });
  </script>
