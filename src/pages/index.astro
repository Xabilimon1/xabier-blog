---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const all = (await getCollection("posts", ({ data }) => !data.draft && data.lang === "es"))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const dateFmt = (d: Date) =>
  new Intl.DateTimeFormat("en-GB", { day: "2-digit", month: "short", year: "numeric" }).format(d);
---

<Layout
  title="Xabier Ariznabarreta"
  description="Xabier Ariznabarreta, 19, from Madrid. AI Engineering student pivoting to safety research. Public notebook: LLM evals, agent harnesses, mech interp, and production lessons."
  current="home"
  lang="en"
>
  <p class="lead">
    Musings of an AI engineering student pivoting to safety research. Notes on
    LLM evals, agent harnesses, mech interp, and production lessons.
  </p>

  <p class="lead">
    Madrid. 19. Second-year at Universidad Francisco de Vitoria. Working on
    my first empirical paper. See <a href="/about">about</a> for the long version.
  </p>

  <h2 style="font-size:20px; font-weight:400; letter-spacing:-0.5px; margin:36px 0 12px;">Posts</h2>

  {all.length === 0 ? (
    <p style="color:#818181; font-size:15px;">
      First post is in the oven. Subscribe via <a href="/rss.xml">RSS</a>.
    </p>
  ) : (
    <ul class="post-list">
      {all.map((post) => (
        <li>
          <span class="post-date">{dateFmt(post.data.publishedAt)}</span>
          <a class="post-link" href={`/posts/${post.id}`}>{post.data.title}</a>
          <p class="post-excerpt">{post.data.excerpt}</p>
        </li>
      ))}
    </ul>
  )}
</Layout>
