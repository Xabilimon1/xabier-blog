---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const all = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

const dateFmt = (d: Date) =>
  new Intl.DateTimeFormat("en-GB", { day: "2-digit", month: "short", year: "numeric" }).format(d);

const categoryLabel = (c: string) =>
  c === "tech" ? "Tech" : c === "research" ? "Research" : c === "production" ? "Production" : "Meta";
---

<Layout title="Xabier Ariznabarreta — Builder & researcher" current="home">

  <div class="hero">
    <div class="avatar"><span class="initials">X</span></div>
    <h1>Xabier Ariznabarreta</h1>
    <p class="role">I'm an <span class="accent">AI agent builder &amp; researcher-in-training</span></p>

    <div class="social-row">
      <a href="https://github.com/Xabilimon1" title="GitHub" target="_blank" rel="noopener">
        <iconify-icon icon="ph:github-logo-fill" width="20" height="20"></iconify-icon>
      </a>
      <a href="mailto:xabier.ariznabarreta@gmail.com" title="Email">
        <iconify-icon icon="ph:envelope-simple" width="20" height="20"></iconify-icon>
      </a>
      <a href="/rss.xml" title="RSS">
        <iconify-icon icon="ph:rss-simple" width="20" height="20"></iconify-icon>
      </a>
    </div>

    <a href="/blog" class="btn-pill">
      Read the blog
      <iconify-icon icon="ph:arrow-right" width="14" height="14"></iconify-icon>
    </a>

    <div class="scroll-cue">
      <div>Scroll Down</div>
      <div class="mouse"></div>
    </div>
  </div>

  <section class="section" id="about">
    <h2 class="section-heading">About Me</h2>

    <div class="about">
      <div class="about-portrait">
        <span class="initials">XA</span>
      </div>

      <div class="about-body">
        <div class="about-bio">
          <p>I'm <strong>Xabier</strong>, 19, second-year <strong>AI Engineering</strong> student at Universidad Francisco de Vitoria, Madrid. For the last 18 months I've been shipping agentic systems to production — Salesforce sales agents, MCP servers with security review loops, Android field assistants, multilingual institutional tooling.</p>
          <p>Now I'm pivoting to <strong>research</strong>. Working on my first empirical paper: an ablation study of agent-harness components. This site is the public notebook.</p>
          <a href="https://github.com/Xabilimon1" target="_blank" rel="noopener" class="btn-pill">
            GitHub profile
            <iconify-icon icon="ph:arrow-up-right" width="14" height="14"></iconify-icon>
          </a>
        </div>

        <div class="about-skills">
          <div class="skill" data-color="orange">
            <div class="skill-head"><span>Production agents</span><span class="pct">85%</span></div>
            <div class="skill-track"><div class="skill-bar" style="width:85%"></div></div>
          </div>
          <div class="skill" data-color="mint">
            <div class="skill-head"><span>LLM research</span><span class="pct">55%</span></div>
            <div class="skill-track"><div class="skill-bar" style="width:55%"></div></div>
          </div>
          <div class="skill" data-color="red">
            <div class="skill-head"><span>Mech interp</span><span class="pct">35%</span></div>
            <div class="skill-track"><div class="skill-bar" style="width:35%"></div></div>
          </div>
          <div class="skill" data-color="blue">
            <div class="skill-head"><span>Eval methodology</span><span class="pct">50%</span></div>
            <div class="skill-track"><div class="skill-bar" style="width:50%"></div></div>
          </div>
        </div>
      </div>
    </div>

    <div class="stats">
      <div class="stat">
        <div class="stat-icon">
          <iconify-icon icon="ph:desktop-tower" width="28" height="28"></iconify-icon>
        </div>
        <div>
          <div class="stat-value">7+</div>
          <div class="stat-label">Systems shipped</div>
        </div>
      </div>
      <div class="stat">
        <div class="stat-icon">
          <iconify-icon icon="ph:coffee" width="28" height="28"></iconify-icon>
        </div>
        <div>
          <div class="stat-value">∞</div>
          <div class="stat-label">Cups of coffee</div>
        </div>
      </div>
      <div class="stat">
        <div class="stat-icon">
          <iconify-icon icon="ph:file-search" width="28" height="28"></iconify-icon>
        </div>
        <div>
          <div class="stat-value">1</div>
          <div class="stat-label">Paper in progress</div>
        </div>
      </div>
      <div class="stat">
        <div class="stat-icon">
          <iconify-icon icon="ph:cake" width="28" height="28"></iconify-icon>
        </div>
        <div>
          <div class="stat-value">19</div>
          <div class="stat-label">Years old</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="latest">
    <div style="display:flex; justify-content:space-between; align-items:flex-end; gap:24px; margin-bottom:28px;">
      <h2 class="section-heading" style="margin-bottom:0;">Latest Posts</h2>
      <a href="/blog" style="font-size:12px; letter-spacing:0.08em; text-transform:uppercase; color:var(--coral); font-weight:600; display:inline-flex; gap:6px; align-items:center;">
        All posts
        <iconify-icon icon="ph:arrow-right" width="12" height="12"></iconify-icon>
      </a>
    </div>

    {all.length === 0 ? (
      <div class="card" style="padding:36px 28px; text-align:center;">
        <iconify-icon icon="ph:hourglass" width="36" height="36" style="color:var(--ink-300);"></iconify-icon>
        <p style="color:var(--ink-500); margin:12px 0 0;">
          First post is in the oven. Subscribe to <a href="/rss.xml">RSS</a> if you want a ping the moment it lands.
        </p>
      </div>
    ) : (
      <div class="posts">
        {all.map((post) => (
          <a href={`/posts/${post.slug}`} class="post-card">
            <div class="post-cover" data-c={post.data.color}>
              <iconify-icon icon={post.data.icon} width="36" height="36"></iconify-icon>
            </div>
            <div>
              <div class="post-meta">
                <span class="badge" data-c={post.data.color}>{categoryLabel(post.data.category)}</span>
                <span>{dateFmt(post.data.publishedAt)}</span>
              </div>
              <h3 class="post-title">{post.data.title}</h3>
              <p class="post-excerpt">{post.data.excerpt}</p>
            </div>
            <div class="post-arrow">
              <iconify-icon icon="ph:arrow-right" width="14" height="14"></iconify-icon>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>

  <section class="section" id="topics">
    <h2 class="section-heading">Topics</h2>
    <p style="color:var(--ink-500); margin: -8px 0 28px; font-size: 14.5px; max-width: 560px;">
      Four kinds of posts. Pick the one that sounds most like you.
    </p>

    <div class="topics-grid">
      <a href="/blog" class="value-card" data-c="yellow">
        <div class="ico">
          <iconify-icon icon="ph:books-fill" width="22" height="22"></iconify-icon>
        </div>
        <h4>Tech deep-dives</h4>
        <p>Rigorous explanations of LLM internals, transformers from scratch, mech interp, eval methodology. Depth before speed.</p>
      </a>

      <a href="/blog" class="value-card" data-c="purple">
        <div class="ico">
          <iconify-icon icon="ph:flask-fill" width="22" height="22"></iconify-icon>
        </div>
        <h4>Research notes</h4>
        <p>Work-in-progress on the harness-ablation paper. Hypotheses, design choices, and null findings included.</p>
      </a>

      <a href="/blog" class="value-card" data-c="coral">
        <div class="ico">
          <iconify-icon icon="ph:shield-check-fill" width="22" height="22"></iconify-icon>
        </div>
        <h4>Production lessons</h4>
        <p>Honest case studies from systems I've shipped, including the expensive mistakes — auth bugs, fake crypto, the works.</p>
      </a>

      <a href="/blog" class="value-card" data-c="mint">
        <div class="ico">
          <iconify-icon icon="ph:atom-fill" width="22" height="22"></iconify-icon>
        </div>
        <h4>Meta journey</h4>
        <p>Reflections on pivoting from production to research at 19, ARENA progress, and the honest self-critique that comes with it.</p>
      </a>

      <a href="/blog" class="value-card span-2" data-c="blue">
        <div class="ico">
          <iconify-icon icon="ph:notebook-fill" width="22" height="22"></iconify-icon>
        </div>
        <h4>Notebook</h4>
        <p>Short-form entries that don't earn a full post yet: paper notes, TIL fragments, half-finished thoughts I want timestamped before I forget them.</p>
      </a>
    </div>
  </section>

  <div class="foot-note">
    Want the long version? Read <a href="/about">about me</a> or <a href="/contact">get in touch</a>.
  </div>

</Layout>
