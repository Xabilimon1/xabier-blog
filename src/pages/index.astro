---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Projects from "../components/Projects.astro";
import { getCollection } from "astro:content";
import { AUTHOR } from "../lib/site";
import { isoDate } from "../lib/format";

const all = (await getCollection("posts", ({ data }) => !data.draft && data.lang === "en"))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const featured = all[0];
const rest = all.slice(1);

const [emailUser, emailDomain] = AUTHOR.email.split("@");
const [domainName, ...domainTail] = emailDomain.split(".");
---

<Layout
  title="Xabier Ariznabarreta: AI, taken apart"
  description="Xabier Ariznabarreta, AI engineering student in Madrid. I take AI systems apart to see how they work and where they break: agent harnesses, evals, and the insides of models."
  current="home"
  lang="en"
  wide
>
  <section class="hero">
    <div class="hero-text">
      <h1 class="hero-title">AI, taken apart.</h1>
      <p class="lead">
        I'm Xabier, a third-year AI engineering student in Madrid. I take AI
        systems apart to see how they work and where they break: agent
        harnesses, evals, and the insides of models.
      </p>
      <p class="code-comment">// It started with Minecraft mods. Now it's language models.</p>
      <p class="hero-actions">
        <a class="btn btn-primary" href="#teardowns">See the teardowns ↓</a>
        <a class="btn btn-quiet" href="/blog">Read the blog →</a>
      </p>
    </div>
  </section>

  <div class="overview">
  <section class="panel title-block" aria-labelledby="profile-title">
    <p class="tabbar"><span class="tab" id="profile-title">Profile</span></p>
    <ul class="rows">
      <li class="row row-head" aria-hidden="true"><span>Name</span><span>Value</span><span></span></li>
      <li class="row">
        <span class="row-label">Drawn by</span>
        <a class="row-value" href="/about">Xabier Ariznabarreta</a>
        <span class="row-actions"><span class="btn-fill" aria-hidden="true">About →</span></span>
      </li>
      <li class="row">
        <span class="row-label">School</span>
        <a class="row-value" href="https://www.ufv.es" rel="noopener">AI Engineering, year 3, Universidad Francisco de Vitoria</a>
        <span class="row-actions"><span class="btn-fill" aria-hidden="true">Open ↗</span></span>
      </li>
      <li class="row">
        <span class="row-label">Email</span>
        <a class="row-value mail" href="/contact" data-user={emailUser} data-domain={emailDomain}>
          {emailUser} [at] {domainName} (dot) {domainTail.join(".")}
        </a>
        <span class="row-actions">
          <button class="btn-fill copy" type="button" data-user={emailUser} data-domain={emailDomain} aria-label="Copy email address">Copy</button>
        </span>
      </li>
      <li class="row">
        <span class="row-label">GitHub</span>
        <a class="row-value" href={AUTHOR.github} rel="noopener me">@Xabilimon1</a>
        <span class="row-actions"><span class="btn-fill" aria-hidden="true">Open ↗</span></span>
      </li>
    </ul>
  </section>

  {featured && (
    <section class="panel latest" aria-labelledby="latest-title">
      <p class="tabbar"><span class="tab">Latest note</span></p>
      <div class="panel-body">
      <p class="meta">
        <time datetime={featured.data.publishedAt.toISOString()}>{isoDate(featured.data.publishedAt)}</time>
        <span>{featured.data.readingMinutes} min read</span>
      </p>
      <h2 class="latest-title" id="latest-title">
        <a href={`/posts/${featured.id}`}>{featured.data.title}</a>
      </h2>
      <p class="latest-excerpt">{featured.data.excerpt}</p>
      </div>
    </section>
  )}
  </div>

  <Projects />

  {rest.length > 0 && (
    <section class="writing" aria-labelledby="writing-title">
      <header class="section-head">
        <h2 class="section-title" id="writing-title">More writing</h2>
        <p class="section-count"><a href="/blog">All posts →</a></p>
      </header>
      <ul class="log">
        {rest.map((post) => (
          <li>
            <time datetime={post.data.publishedAt.toISOString()}>{isoDate(post.data.publishedAt)}</time>
            <a class="log-title" href={`/posts/${post.id}`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {all.length === 0 && (
    <p class="empty">First post is in the oven. Subscribe via <a href="/rss.xml">RSS</a>.</p>
  )}
</Layout>

<script>
  // The address is assembled here, not written in the HTML, to keep it from scrapers.
  for (const link of document.querySelectorAll<HTMLAnchorElement>("a.mail")) {
    link.href = `mailto:${link.dataset.user}@${link.dataset.domain}`;
  }
  for (const button of document.querySelectorAll<HTMLButtonElement>("button.copy")) {
    button.addEventListener("click", async () => {
      const address = `${button.dataset.user}@${button.dataset.domain}`;
      try {
        await navigator.clipboard.writeText(address);
        button.textContent = "Copied";
      } catch {
        button.textContent = address;
      }
      setTimeout(() => (button.textContent = "Copy"), 2000);
    });
  }
</script>
