---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import { SITE } from "../lib/site";

const profilePage = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${SITE}/about#profilepage`,
  url: `${SITE}/about`,
  mainEntity: { "@id": `${SITE}/#person` },
  dateModified: new Date("2026-07-07").toISOString(),
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE },
      { "@type": "ListItem", position: 2, name: "About", item: `${SITE}/about` },
    ],
  },
};
---

<Layout
  title="About — Xabier Ariznabarreta"
  description="Xabier Ariznabarreta: 19, Madrid. Second-year AI Engineering student at UFV. Pivoting from shipping production agents to alignment / interpretability research."
  current="about"
  lang="en"
  jsonLd={profilePage}
>
  <h1 style="font-size:38px; font-weight:500; letter-spacing:normal; margin:20px 0 20px;">About</h1>

  <div class="post-content">
    <p>
      I'm Xabier Ariznabarreta. Born and raised in Madrid. I did high school
      at Trinity College in San Sebastián de los Reyes and now study
      <strong>AI Engineering</strong> at Universidad Francisco de Vitoria.
    </p>

    <p>
      I started building AI projects at the beginning of my second year of the
      degree and shipped my first production agent a few months later. Since
      then I've sent several to production: commercial agents integrated with
      Salesforce, MCP servers with security-review loops, Android field
      assistants, multilingual institutional tooling.
    </p>

    <p>
      The work was useful. It was also a teacher. The bugs were instructive,
      the customers were patient, and the experience showed me where the
      bottleneck is — not in the engineering, but in the science underneath.
    </p>

    <p>
      So I'm pivoting to research. The first concrete step has been
      contributing to the open-source evaluation frameworks that safety
      organizations actually run. This site is the public notebook for the
      rest of it.
    </p>

    <h2>What you'll find here</h2>
    <p>Four kinds of posts:</p>
    <ul>
      <li><strong>Technical deep-dives</strong> — rigorous explanations of LLM concepts, transformer internals, mech interp, eval methodology.</li>
      <li><strong>Research notes</strong> — evals, agent harnesses, and whatever I'm working through at the time.</li>
      <li><strong>Production lessons</strong> — honest case studies from systems I've shipped, expensive mistakes included.</li>
      <li><strong>Meta journey</strong> — reflections on the builder-to-researcher pivot at 19.</li>
    </ul>

    <h2>Elsewhere</h2>
    <p>
      <a href="https://github.com/Xabilimon1" rel="noopener me">GitHub</a>
      &nbsp;·&nbsp;
      <a href="mailto:xabier.ariznabarreta@gmail.com" rel="me">Email</a>
      &nbsp;·&nbsp;
      <a href="/rss.xml">RSS</a>
    </p>
    <p style="font-size:14px; color:#818181;">
      The links above are the canonical me. If you see a Xabier Ariznabarreta
      account somewhere that isn't linked here, it isn't me.
    </p>
  </div>
</Layout>
