---
export const prerender = true;
import Layout from "../layouts/Layout.astro";

Astro.response.status = 404;
Astro.response.statusText = "Not Found";
---

<Layout
  title="404 — Xabier Ariznabarreta"
  description="La página que buscas no existe."
  current="home"
  lang="es"
  noindex={true}
>
  <h1 style="font-size:38px; font-weight:500; letter-spacing:normal; margin:40px 0 12px;">404</h1>
  <p class="lead">
    Esta página no existe. Vuelve al <a href="/">inicio</a> o al <a href="/blog">blog</a>.
  </p>
</Layout>
