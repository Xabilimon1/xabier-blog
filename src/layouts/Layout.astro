---
import JsonLd from "../components/JsonLd.astro";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import {
  SITE,
  SITE_HOST,
  SITE_NAME,
  SITE_DESCRIPTION_ES,
  SITE_DESCRIPTION_EN,
  AUTHOR,
  canonicalFor,
} from "../lib/site";

interface Alternate {
  href: string;
  hreflang: string;
}

interface Props {
  title: string;
  description?: string;
  current: "home" | "about" | "resume" | "blog" | "contact";
  lang?: "es" | "en";
  ogType?: "website" | "article" | "profile";
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  articleAuthor?: string;
  articleSection?: string;
  articleTags?: string[];
  alternates?: Alternate[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  current,
  lang = "es",
  ogType = "website",
  publishedTime,
  modifiedTime,
  articleAuthor,
  articleSection,
  articleTags,
  alternates,
  noindex = false,
  jsonLd,
} = Astro.props;

const defaultDescription = lang === "es" ? SITE_DESCRIPTION_ES : SITE_DESCRIPTION_EN;
const description = Astro.props.description ?? defaultDescription;

const canonical = canonicalFor(Astro.url.pathname);

const isCanonicalHost = Astro.url.hostname === SITE_HOST;
const shouldNoindex = noindex || !isCanonicalHost;

const ogLocale = lang === "es" ? "es_ES" : "en_US";
const ogAltLocale = lang === "es" ? "en_US" : "es_ES";

const toIso = (d?: Date | string) =>
  typeof d === "string" ? d : d instanceof Date ? d.toISOString() : undefined;
const publishedIso = toIso(publishedTime);
const modifiedIso = toIso(modifiedTime);

// Person + WebSite JSON-LD — always emitted (name-search / knowledge graph)
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE}/#person`,
  name: AUTHOR.name,
  alternateName: AUTHOR.alternateName,
  jobTitle: AUTHOR.jobTitle,
  url: SITE,
  email: `mailto:${AUTHOR.email}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: AUTHOR.location,
    addressCountry: "ES",
  },
  worksFor: { "@type": "Organization", name: "Independent" },
  knowsAbout: [
    "AI safety",
    "AI alignment",
    "Large language models",
    "LLM agents",
    "Evaluation harnesses",
    "Mechanistic interpretability",
  ],
  sameAs: AUTHOR.sameAs,
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE}/#website`,
  url: SITE,
  name: SITE_NAME,
  inLanguage: lang === "es" ? "es-ES" : "en-US",
  publisher: { "@id": `${SITE}/#person` },
  description: defaultDescription,
};

const globalJsonLd: Array<Record<string, unknown>> = [personSchema, websiteSchema];
const combinedJsonLd = jsonLd
  ? Array.isArray(jsonLd)
    ? [...globalJsonLd, ...jsonLd]
    : [...globalJsonLd, jsonLd]
  : globalJsonLd;

const navLinks: Array<{ href: string; label: string; key: Props["current"] }> = [
  { href: "/", label: "Home", key: "home" },
  { href: "/blog", label: "Blog", key: "blog" },
  { href: "/about", label: "About", key: "about" },
  { href: "/resume", label: "Resume", key: "resume" },
  { href: "/contact", label: "Contact", key: "contact" },
];
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content={AUTHOR.name} />
  <meta name="theme-color" content="#fdfdfd" />

  <link rel="canonical" href={canonical} />
  {shouldNoindex && <meta name="robots" content="noindex, nofollow" />}
  {!shouldNoindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

  {alternates?.map((a) => (
    <link rel="alternate" hreflang={a.hreflang} href={a.href} />
  ))}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
  <link rel="alternate icon" type="image/x-icon" href="/favicon.ico?v=3" />
  <link rel="apple-touch-icon" href="/favicon.svg?v=3" />
  <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} — RSS`} href="/rss.xml" />

  <!-- Open Graph (text-only, no image per Karpathy convention) -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:locale:alternate" content={ogAltLocale} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />

  {ogType === "article" && publishedIso && (
    <meta property="article:published_time" content={publishedIso} />
  )}
  {ogType === "article" && modifiedIso && (
    <meta property="article:modified_time" content={modifiedIso} />
  )}
  {ogType === "article" && (
    <meta property="article:author" content={articleAuthor ?? AUTHOR.name} />
  )}
  {ogType === "article" && articleSection && (
    <meta property="article:section" content={articleSection} />
  )}
  {ogType === "article" && articleTags?.map((t) => (
    <meta property="article:tag" content={t} />
  ))}

  <!-- Twitter Card — summary (text-only) -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <link rel="stylesheet" href="/styles.css?v=7" />

  <JsonLd data={combinedJsonLd} />
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="site-title" href="/">{SITE_NAME}</a>
      <nav class="site-nav" aria-label="Primary">
        {navLinks.map((l) => (
          <a
            href={l.href}
            aria-current={current === l.key ? "page" : undefined}
          >{l.label}</a>
        ))}
      </nav>
    </div>
  </header>

  <main class="page-content">
    <div class="wrap">
      <slot />
    </div>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div>© 2026 {SITE_NAME}</div>
      <div>
        <a href="/rss.xml">RSS</a>
        &nbsp;·&nbsp;
        <a href="https://github.com/Xabilimon1" rel="noopener me">GitHub</a>
      </div>
    </div>
  </footer>

  <Analytics />
  <SpeedInsights />
</body>
</html>
