---
import Layout from "./Layout.astro";
import Comments from "../components/Comments.astro";
import { getCollection } from "astro:content";
import { SITE, SITE_NAME, AUTHOR } from "../lib/site";

interface Props {
  title: string;
  excerpt: string;
  publishedAt: Date;
  updatedAt?: Date;
  category: "tech" | "research" | "production" | "meta";
  readingMinutes: number;
  icon?: string;
  color?: "coral" | "mint" | "yellow" | "purple" | "blue";
  lang?: "es" | "en";
  translationOf?: string;
  keywords?: string[];
  noindex?: boolean;
  slug: string;
}

const {
  title,
  excerpt,
  publishedAt,
  updatedAt,
  category,
  readingMinutes,
  lang = "es",
  translationOf,
  keywords,
  noindex = false,
  slug,
} = Astro.props;

const dateLocale = lang === "es" ? "es-ES" : "en-GB";
const dateFmt = new Intl.DateTimeFormat(dateLocale, {
  day: "2-digit", month: "short", year: "numeric",
}).format(publishedAt);
const updatedFmt = updatedAt
  ? new Intl.DateTimeFormat(dateLocale, { day: "2-digit", month: "short", year: "numeric" }).format(updatedAt)
  : null;

const readLabel = lang === "es" ? "min de lectura" : "min read";
const footLabel = lang === "es"
  ? "¿Encontraste algo mal?"
  : "Found something wrong?";
const footCta = lang === "es" ? "Escríbeme" : "Email me";
const footTail = lang === "es" ? " y lo arreglo." : " and I'll fix it.";
const updatedLabel = lang === "es" ? "Actualizado" : "Updated";
const otherLang = lang === "es" ? "en" : "es";
const otherLangLabel = otherLang === "es" ? "Español" : "English";

const selfPath = `/posts/${slug}`;
const selfUrl = `${SITE}${selfPath}`;
const counterpartPath = translationOf ? `/posts/${translationOf}` : null;
const counterpartUrl = counterpartPath ? `${SITE}${counterpartPath}` : null;

const alternates = counterpartUrl
  ? [
      { hreflang: lang === "es" ? "es" : "en", href: selfUrl },
      { hreflang: otherLang, href: counterpartUrl },
      { hreflang: "x-default", href: lang === "en" ? selfUrl : counterpartUrl },
    ]
  : [
      { hreflang: lang === "es" ? "es" : "en", href: selfUrl },
      { hreflang: "x-default", href: selfUrl },
    ];

const blogPosting = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${selfUrl}#article`,
  mainEntityOfPage: { "@type": "WebPage", "@id": selfUrl },
  headline: title,
  description: excerpt,
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  author: { "@id": `${SITE}/#person` },
  publisher: { "@id": `${SITE}/#person` },
  inLanguage: lang === "es" ? "es-ES" : "en-US",
  articleSection: category,
  keywords: keywords?.join(", "),
  wordCount: Math.round(readingMinutes * 220),
  ...(counterpartUrl && {
    translationOfWork: lang === "en" ? undefined : { "@id": `${counterpartUrl}#article` },
    workTranslation: lang === "en" ? { "@id": `${counterpartUrl}#article` } : undefined,
  }),
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE_NAME, item: SITE },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE}${lang === "en" ? "/en/blog" : "/blog"}` },
    { "@type": "ListItem", position: 3, name: title, item: selfUrl },
  ],
};

// Related — same category + lang, exclude self, up to 3
const relatedPool = await getCollection(
  "posts",
  ({ data, id }) =>
    !data.draft && data.category === category && data.lang === lang && id !== slug,
);
const relatedPosts = relatedPool
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
const relatedFmt = new Intl.DateTimeFormat(dateLocale, {
  day: "2-digit", month: "short", year: "numeric",
});
const relatedHeading = lang === "es" ? "Más lectura" : "More reading";
---

<Layout
  title={`${title} — ${SITE_NAME}`}
  description={excerpt}
  current="blog"
  lang={lang}
  ogType="article"
  publishedTime={publishedAt}
  modifiedTime={updatedAt}
  articleAuthor={AUTHOR.name}
  articleSection={category}
  articleTags={keywords}
  alternates={alternates}
  noindex={noindex}
  jsonLd={[blogPosting, breadcrumb]}
>

  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={publishedAt.toISOString()}>{dateFmt}</time>
        &nbsp;·&nbsp; {readingMinutes} {readLabel}
        {updatedFmt && (
          <>&nbsp;·&nbsp; {updatedLabel} <time datetime={updatedAt!.toISOString()}>{updatedFmt}</time></>
        )}
        {translationOf && (
          <span class="lang-toggle">
            <span class="sep">·</span>
            <a href={`/posts/${translationOf}`}>{otherLangLabel}</a>
          </span>
        )}
      </p>
    </header>

    <div class="post-content">
      <slot />
    </div>
  </article>

  <p class="foot-note">
    {footLabel} <a href="/contact">{footCta}</a>{footTail}
  </p>

  {relatedPosts.length > 0 && (
    <section class="related">
      <h2 class="related-heading">{relatedHeading}</h2>
      <ul class="related-list">
        {relatedPosts.map((post) => (
          <li>
            <span class="date">{relatedFmt.format(post.data.publishedAt)}</span>
            <a href={`/posts/${post.id}`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <Comments />

</Layout>
