---
const links = [
  { href: "#home", label: "Home", icon: "🏠" },
  { href: "#about", label: "About", icon: "👤" },
  { href: "#now", label: "Now", icon: "⚡" },
  { href: "#projects", label: "Projects", icon: "🧪" },
  { href: "#posts", label: "Posts", icon: "✍️" },
  { href: "#contact", label: "Contact", icon: "✉️" },
];
---

<aside class="fixed left-0 top-0 h-screen w-16 lg:w-20 bg-white border-r border-[var(--color-line)] flex flex-col items-center py-8 z-50">
  <a href="/" class="font-display text-2xl font-bold text-[var(--color-ink)] mb-12">
    X.
  </a>

  <nav class="flex flex-col gap-6 flex-1">
    {links.map((link) => (
      <a
        href={link.href}
        class="text-[var(--color-mute)] hover:text-[var(--color-coral)] transition-colors text-xl"
        title={link.label}
        aria-label={link.label}
      >
        <span>{link.icon}</span>
      </a>
    ))}
  </nav>

  <div class="text-[10px] text-[var(--color-mute)] [writing-mode:vertical-rl] rotate-180 tracking-wider">
    © 2026 Xabier
  </div>
</aside>
