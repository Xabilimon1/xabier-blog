---
const categories = [
  {
    name: "Research",
    color: "purple",
    bg: "#EDE9FE",
    accent: "#A78BFA",
    items: [
      { name: "harness-ablation", desc: "Empirical paper on LLM agent harness components", link: "https://github.com/Xabilimon1/harness-ablation" },
      { name: "arena-solutions", desc: "ARENA curriculum + mech interp experiments", link: "https://github.com/Xabilimon1/xabier-arena-solutions" },
    ],
    icon: "🧪",
  },
  {
    name: "Production",
    color: "yellow",
    bg: "#FEF3C7",
    accent: "#F59E0B",
    items: [
      { name: "LinceReservations", desc: "Full-stack room booking system deployed at UFV", link: "https://github.com/Xabilimon1/LinceReservations" },
      { name: "SAMRobot", desc: "Salesforce + MCP commercial agent stack", link: "#" },
      { name: "innova-ufv", desc: "Evaluator management for 30 university teachers", link: "#" },
    ],
    icon: "⚙️",
  },
  {
    name: "Writing",
    color: "pink",
    bg: "#FCE7F3",
    accent: "#F472B6",
    items: [
      { name: "Token Budget Advisor", desc: "Claude Code skill for token estimation", link: "https://github.com/Xabilimon1/TBA-Token-Budget-Advisor-Claude-Code" },
      { name: "This blog", desc: "Technical deep-dives, research notes, lessons", link: "#posts" },
    ],
    icon: "✍️",
  },
];
---

<section id="projects" class="relative px-6 py-24 max-w-6xl mx-auto">
  <h2 class="text-4xl font-bold mb-3 text-center">What I work on</h2>
  <p class="text-center text-[var(--color-mute)] mb-12">Three lanes: research output, production engineering, writing.</p>

  <div class="grid md:grid-cols-3 gap-6">
    {categories.map((cat) => (
      <div
        class="rounded-3xl p-8 transition-transform hover:-translate-y-1"
        style={`background-color: ${cat.bg};`}
      >
        <div class="text-4xl mb-6">{cat.icon}</div>
        <h3 class="text-2xl font-bold mb-4" style={`color: ${cat.accent};`}>
          {cat.name}
        </h3>
        <ul class="space-y-3">
          {cat.items.map((item) => (
            <li>
              <a
                href={item.link}
                class="block group"
                target={item.link.startsWith("http") ? "_blank" : undefined}
                rel={item.link.startsWith("http") ? "noopener" : undefined}
              >
                <div class="font-semibold text-[var(--color-ink)] group-hover:underline">
                  {item.name}
                </div>
                <div class="text-sm text-[var(--color-mute)] leading-snug">
                  {item.desc}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
