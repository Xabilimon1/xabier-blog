---
import { projects } from "../lib/projects";
import Cover from "./Cover.astro";

const external = (href: string) => href.startsWith("http");
// Offsets in the hex-editor style: 0x01, 0x02...
const hex = (i: number) => `0x${(i + 1).toString(16).toUpperCase().padStart(2, "0")}`;
// Each demo is named after its file, as ImHex names its views.
const fileName = (src?: string) => src?.split("/").pop() ?? "no data";
---

<section class="teardowns" id="teardowns" aria-labelledby="teardowns-title">
  <header class="section-head">
    <h2 class="section-title" id="teardowns-title">Teardowns</h2>
  </header>

  <!-- One ImHex window with its three panes as columns (Pattern Data, view,
       Data Inspector); every project is a band across all three. -->
  <div class="panel imhex">
    <div class="ih-cols" aria-hidden="true">
      <p class="tabbar"><span class="tab">Pattern Data</span><span class="tabbar-note">{projects.length} entries</span></p>
      <p class="tabbar"><span class="tab">View</span></p>
      <p class="tabbar"><span class="tab">Data Inspector</span></p>
    </div>

    {projects.map((p, i) => (
      <article class="ih-band" id={p.slug} aria-labelledby={`${p.slug}-name`}>
        <header class="ih-entry">
          <span class={`chip c${i % 7}`} aria-hidden="true">{hex(i)}</span>
          <h3 class="ih-name" id={`${p.slug}-name`}>{p.name}</h3>
          <span class="ih-type">{p.status === "open" ? "open source" : "closed source"}</span>
          <span class="ih-file">{fileName(p.media)}</span>
        </header>
        <div class="ih-view">
          <Cover project={p} />
          {p.links.length > 0 && (
            <p class="ih-links">
              {p.links.map((l) => (
                <a class="btn btn-small" href={l.href} rel={external(l.href) ? "noopener" : undefined}>
                  {l.label} {external(l.href) ? "↗" : "→"}
                </a>
              ))}
            </p>
          )}
        </div>
        <dl class="ih-table">
          <div class="ih-th" aria-hidden="true"><span>Name</span><span>Value</span></div>
          <div><dt>about</dt><dd class="ih-text">{p.blurb}</dd></div>
          <div><dt>parts</dt><dd class="ih-char">{p.parts.join(", ")}</dd></div>
          {p.brokeAt && <div class="ih-broke"><dt>broke at</dt><dd>{p.brokeAt}</dd></div>}
        </dl>
      </article>
    ))}
  </div>
</section>
