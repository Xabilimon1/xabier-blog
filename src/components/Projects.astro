---
import { projects } from "../lib/projects";

const external = (href: string) => href.startsWith("http");
const isVideo = (src: string) => /\.(mp4|webm)$/i.test(src);
// Index offsets in the hex-editor style: 0x01, 0x02...
const hex = (i: number) => `0x${(i + 1).toString(16).toUpperCase().padStart(2, "0")}`;
---

<section class="teardowns" id="teardowns" aria-labelledby="teardowns-title">
  <header class="section-head">
    <h2 class="section-title" id="teardowns-title">Teardowns</h2>
  </header>

  <div class="teardowns-grid">
    <nav class="panel index" aria-label="Index of teardowns">
      <p class="tabbar"><span class="tab">Index</span><span class="tabbar-note">{projects.length}</span></p>
      <ol>
        {projects.map((p, i) => (
          <li>
            <a class="index-row" href={`#${p.slug}`} data-slug={p.slug}>
              <span class={`chip c${i % 7}`} aria-hidden="true">{hex(i)}</span>
              <span class="index-name">{p.name}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="records">
      {projects.map((p, i) => (
        <article class="panel teardown" id={p.slug} aria-labelledby={`${p.slug}-name`}>
          <header class="tabbar">
            <h3 class="tab" id={`${p.slug}-name`}><span class={`chip c${i % 7}`} aria-hidden="true">{hex(i)}</span>{p.name}</h3>
            <p class="tabbar-note">{p.status === "open" ? "Open source" : "Closed source"}</p>
          </header>

          <div class="teardown-body">
            <figure class="fig">
              <div class="fig-frame">
                {p.media ? (
                  isVideo(p.media) ? (
                    <video src={p.media} autoplay muted loop playsinline aria-label={`${p.name} demo`}></video>
                  ) : (
                    <img src={p.media} alt={`${p.name} demo`} loading="lazy" width="1280" height="800" />
                  )
                ) : (
                  <p class="fig-empty">No demo<br />loaded</p>
                )}
              </div>
            </figure>

            <div class="teardown-text">
              <p class="teardown-blurb">{p.blurb}</p>
              <dl class="spec">
                <dt>Parts</dt>
                <dd>{p.parts.join(", ")}</dd>
                {p.brokeAt && (
                  <>
                    <dt class="broke">Where it broke</dt>
                    <dd class="broke">{p.brokeAt}</dd>
                  </>
                )}
              </dl>
              {p.links.length > 0 && (
                <p class="spec-links">
                  {p.links.map((l) => (
                    <a class="btn btn-small" href={l.href} rel={external(l.href) ? "noopener" : undefined}>
                      {l.label} {external(l.href) ? "↗" : "→"}
                    </a>
                  ))}
                </p>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // Mark the index entry of the record being read, as the index on thavlik.dev does.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>(".index-row")].map((a) => [a.dataset.slug, a]),
  );
  const seen = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        for (const a of links.values()) a.removeAttribute("aria-current");
        links.get(e.target.id)?.setAttribute("aria-current", "true");
      }
    },
    { rootMargin: "-40% 0px -55% 0px" },
  );
  document.querySelectorAll(".teardown").forEach((el) => seen.observe(el));
</script>
