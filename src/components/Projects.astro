---
import { projects } from "../lib/projects";

const pillClass = (tag: string): string => {
  const t = tag.toLowerCase();
  if (["fastapi", "python", "supabase"].includes(t)) return "pill pill-green";
  if (["salesforce", "react", "typescript", "msal"].includes(t)) return "pill pill-blue";
  if (["tauri"].includes(t)) return "pill pill-rust";
  if (["claude code"].includes(t)) return "pill pill-violet";
  if (["vertex ai", "cloud run"].includes(t)) return "pill pill-brown";
  return "pill";
};

// Clicking the name goes to GitHub when there's a repo; otherwise to the
// project's primary link (e.g. the writeup). Private projects with no link
// render as plain text.
const nameHref = (p: (typeof projects)[number]): string | undefined =>
  p.links.find((l) => l.label === "GitHub")?.href ?? p.links[0]?.href;
---

<section class="projects-section">
  <h2 class="section-heading">Projects</h2>
  <div class="projects">
    {projects.map((p) => (
      <article class="project">
        <div class="project-body">
          <div class="project-head">
            {nameHref(p) ? (
              <h3 class="project-name">
                <a href={nameHref(p)} rel={nameHref(p)!.startsWith("http") ? "noopener" : undefined}>{p.name}</a>
              </h3>
            ) : (
              <h3 class="project-name">{p.name}</h3>
            )}
            <span class={`badge badge-${p.status}`}>
              {p.status === "open" ? "open source" : "closed source"}
            </span>
          </div>
          <p class="project-blurb">{p.blurb}</p>
          <div class="pills">
            {p.tags.map((t) => <span class={pillClass(t)}>{t}</span>)}
          </div>
          {p.links.length > 0 && (
            <div class="project-actions">
              {p.links.map((l) => (
                <a
                  class="proj-btn"
                  href={l.href}
                  rel={l.href.startsWith("http") ? "noopener" : undefined}
                >{l.label} →</a>
              ))}
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</section>
