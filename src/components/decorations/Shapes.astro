---
// Decorative SVG shapes scattered across page
---

<!-- Scattered decorative shapes inspired by Bolby template -->
<div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
  <!-- Top-left half-moon -->
  <svg class="absolute top-12 left-8 opacity-70" width="40" height="40" viewBox="0 0 40 40" fill="none">
    <path d="M5 20 Q5 5 20 5" stroke="#FCD34D" stroke-width="3" stroke-linecap="round" fill="none"/>
  </svg>

  <!-- Top slash -->
  <svg class="absolute top-20 left-1/3 opacity-60" width="30" height="30" viewBox="0 0 30 30" fill="none">
    <line x1="5" y1="25" x2="25" y2="5" stroke="#9CA3AF" stroke-width="3" stroke-linecap="round"/>
  </svg>

  <!-- Top-right curve -->
  <svg class="absolute top-16 right-12 opacity-70" width="40" height="40" viewBox="0 0 40 40" fill="none">
    <path d="M5 20 Q20 5 35 20" stroke="#FF5757" stroke-width="3" stroke-linecap="round" fill="none"/>
  </svg>

  <!-- Triangle small -->
  <svg class="absolute top-1/3 left-16 opacity-50" width="24" height="24" viewBox="0 0 24 24" fill="none">
    <path d="M12 4 L20 20 L4 20 Z" stroke="#FF5757" stroke-width="2.5" fill="none" stroke-linejoin="round"/>
  </svg>

  <!-- Wavy line -->
  <svg class="absolute top-1/2 right-20 opacity-60" width="60" height="20" viewBox="0 0 60 20" fill="none">
    <path d="M2 10 Q15 2 30 10 T58 10" stroke="#A78BFA" stroke-width="2.5" stroke-linecap="round" fill="none"/>
  </svg>

  <!-- Cluster of dots -->
  <svg class="absolute top-1/4 right-1/4 opacity-60" width="30" height="30" viewBox="0 0 30 30" fill="none">
    <circle cx="6" cy="6" r="2.5" fill="#F472B6"/>
    <circle cx="22" cy="10" r="2.5" fill="#F472B6"/>
    <circle cx="12" cy="22" r="2.5" fill="#F472B6"/>
  </svg>

  <!-- Half moon bigger -->
  <svg class="absolute top-3/4 left-12 opacity-70" width="50" height="50" viewBox="0 0 50 50" fill="none">
    <path d="M8 25 Q8 8 25 8" stroke="#A78BFA" stroke-width="3" stroke-linecap="round" fill="none"/>
  </svg>

  <!-- Plus -->
  <svg class="absolute top-2/3 right-1/3 opacity-60" width="24" height="24" viewBox="0 0 24 24" fill="none">
    <line x1="12" y1="3" x2="12" y2="21" stroke="#FCD34D" stroke-width="3" stroke-linecap="round"/>
    <line x1="3" y1="12" x2="21" y2="12" stroke="#FCD34D" stroke-width="3" stroke-linecap="round"/>
  </svg>

  <!-- Y shape -->
  <svg class="absolute top-[10%] right-1/3 opacity-50" width="30" height="30" viewBox="0 0 30 30" fill="none">
    <path d="M15 28 L15 16 M15 16 L5 5 M15 16 L25 5" stroke="#9CA3AF" stroke-width="2.5" stroke-linecap="round" fill="none"/>
  </svg>

  <!-- Squiggle bottom -->
  <svg class="absolute bottom-20 left-1/4 opacity-60" width="60" height="20" viewBox="0 0 60 20" fill="none">
    <path d="M2 10 Q15 18 30 10 T58 10" stroke="#FF5757" stroke-width="2.5" stroke-linecap="round" fill="none"/>
  </svg>
</div>
