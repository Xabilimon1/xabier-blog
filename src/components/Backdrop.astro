---
// Site backdrop: a gearbox drawn in ink on the graph paper, in 3D, that comes
// apart as the page scrolls down (taken apart) and turns slowly. Each part is
// labelled with an offset, the way a disassembler labels code. Canvas 2D, no
// libraries; about 30 frames a second, nothing while the tab is hidden, and
// a still drawing under prefers-reduced-motion.
---

<canvas class="backdrop" aria-hidden="true"></canvas>

<script>
  type V = [number, number, number];
  type Part = { label: string; lines: [V, V][]; anchor: V; move: V };

  const box = (x0: number, y0: number, z0: number, x1: number, y1: number, z1: number): [V, V][] => {
    const c: V[] = [
      [x0, y0, z0], [x1, y0, z0], [x1, y0, z1], [x0, y0, z1],
      [x0, y1, z0], [x1, y1, z0], [x1, y1, z1], [x0, y1, z1],
    ];
    const e = [[0, 1], [1, 2], [2, 3], [3, 0], [4, 5], [5, 6], [6, 7], [7, 4], [0, 4], [1, 5], [2, 6], [3, 7]];
    return e.map(([a, b]) => [c[a], c[b]]);
  };

  // A ring around the z axis at depth z, as a closed polygon.
  const ring = (cx: number, cy: number, z: number, pts: [number, number][]): [V, V][] =>
    pts.map((p, i) => {
      const q = pts[(i + 1) % pts.length];
      return [[cx + p[0], cy + p[1], z], [cx + q[0], cy + q[1], z]];
    });

  const circle = (r: number, n = 28): [number, number][] =>
    Array.from({ length: n }, (_, i) => [r * Math.cos((i / n) * Math.PI * 2), r * Math.sin((i / n) * Math.PI * 2)]);

  const gearOutline = (r: number, teeth: number): [number, number][] => {
    const pts: [number, number][] = [];
    for (let i = 0; i < teeth; i++) {
      const a = (i / teeth) * Math.PI * 2;
      const s = (Math.PI * 2) / teeth;
      for (const [k, rr] of [[0, r], [0.2, r + 0.13], [0.5, r + 0.13], [0.7, r]] as const) {
        pts.push([rr * Math.cos(a + k * s), rr * Math.sin(a + k * s)]);
      }
    }
    return pts;
  };

  // A prism: the same outline at two depths, joined every `step` points.
  const prism = (cx: number, cy: number, z0: number, z1: number, pts: [number, number][], step: number): [V, V][] => [
    ...ring(cx, cy, z0, pts),
    ...ring(cx, cy, z1, pts),
    ...pts.filter((_, i) => i % step === 0).map((p): [V, V] => [[cx + p[0], cy + p[1], z0], [cx + p[0], cy + p[1], z1]]),
  ];

  const parts: Part[] = [
    { label: "0x0000  housing", lines: box(-1.7, -1, -1, 1.7, 0, 1), anchor: [1.7, -1, 1], move: [0, -0.6, 0] },
    { label: "0x0040  lid", lines: box(-1.7, 0, -1, 1.7, 0.22, 1), anchor: [1.7, 0.22, -1], move: [0, 2.6, 0] },
    { label: "0x0080  gear_a", lines: prism(-0.55, -0.4, -0.12, 0.12, gearOutline(0.62, 14), 4), anchor: [-0.55, 0.35, 0.12], move: [-0.9, 1.5, 0.6] },
    { label: "0x00c0  gear_b", lines: prism(0.68, -0.4, -0.12, 0.12, gearOutline(0.4, 9), 4), anchor: [0.68, 0.13, 0.12], move: [1.1, 1.1, 0.9] },
    { label: "0x0100  shaft_a", lines: prism(-0.55, -0.4, -1.5, 1.5, circle(0.08, 10), 5), anchor: [-0.55, -0.4, 1.5], move: [-0.4, 0.2, 2.4] },
    { label: "0x0140  shaft_b", lines: prism(0.68, -0.4, -1.5, 1.5, circle(0.07, 10), 5), anchor: [0.68, -0.4, -1.5], move: [0.4, 0.2, -2.4] },
    ...([[-1.5, -0.8], [1.5, -0.8], [1.5, 0.8], [-1.5, 0.8]] as const).map(([x, z], i): Part => ({
      label: i === 0 ? "0x0180  bolts" : "",
      lines: [...ring(0, 0, 0, circle(0.09, 8)).map(([a, b]): [V, V] => [[x + a[0], 0.22, z + a[1]], [x + b[0], 0.22, z + b[1]]]), [[x, 0.22, z], [x, -0.5, z]]],
      anchor: [x, 0.22, z],
      move: [x * 0.25, 3.6, z * 0.25],
    })),
  ];

  const canvas = document.querySelector<HTMLCanvasElement>("canvas.backdrop")!;
  const ctx = canvas.getContext("2d")!;
  const css = getComputedStyle(document.documentElement);
  const ink = css.getPropertyValue("--ink-3").trim() || "#6b6559";
  const font = css.getPropertyValue("--font").trim();
  const still = matchMedia("(prefers-reduced-motion: reduce)");

  let w = 0, h = 0, dpr = 1;
  const resize = () => {
    dpr = Math.min(devicePixelRatio || 1, 2);
    w = innerWidth;
    h = innerHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  };

  const smooth = (x: number) => x * x * (3 - 2 * x);
  // 0 at the top of the page, 1 once two thirds of it have scrolled past.
  const apart = () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    const p = max > 0 ? Math.min(1, scrollY / (max * 0.66)) : 0;
    return 0.12 + 0.88 * smooth(p);
  };

  let shown = 0.12;
  const draw = (t: number) => {
    shown += (apart() - shown) * 0.08;
    const narrow = w < 860;
    const cx = narrow ? w * 0.66 : w * 0.84;
    const cy = h * 0.6;
    const scale = Math.min(w, h) * (narrow ? 0.11 : 0.115);
    const yaw = still.matches ? 0.65 : 0.65 + t * 0.00006;
    const pitch = -0.5;
    const [cyw, syw, cp, sp] = [Math.cos(yaw), Math.sin(yaw), Math.cos(pitch), Math.sin(pitch)];
    const project = ([x, y, z]: V): [number, number] => {
      const x1 = x * cyw + z * syw;
      const z1 = -x * syw + z * cyw;
      const y1 = y * cp - z1 * sp;
      const z2 = y * sp + z1 * cp;
      const f = 9 / (9 - z2);
      return [cx + x1 * scale * f, cy - y1 * scale * f];
    };

    ctx.clearRect(0, 0, w, h);
    ctx.lineWidth = 1;
    ctx.font = `10px ${font}`;
    for (const part of parts) {
      const k = shown * 0.7;
      const off: V = [part.move[0] * k, part.move[1] * k, part.move[2] * k];
      const at = (v: V): [number, number] => project([v[0] + off[0], v[1] + off[1], v[2] + off[2]]);
      ctx.strokeStyle = ink;
      ctx.globalAlpha = narrow ? 0.14 : 0.22;
      ctx.beginPath();
      for (const [a, b] of part.lines) {
        const [ax, ay] = at(a);
        const [bx, by] = at(b);
        ctx.moveTo(ax, ay);
        ctx.lineTo(bx, by);
      }
      ctx.stroke();

      // Labels appear once the parts are far enough apart to read them.
      const label = Math.max(0, (shown - 0.35) / 0.4);
      if (part.label && label > 0 && !narrow) {
        const [ax, ay] = at(part.anchor);
        ctx.globalAlpha = Math.min(1, label) * 0.4;
        ctx.strokeStyle = ink;
        ctx.beginPath();
        ctx.moveTo(ax, ay);
        ctx.lineTo(ax + 18, ay - 14);
        ctx.lineTo(ax + 24, ay - 14);
        ctx.stroke();
        ctx.fillStyle = ink;
        ctx.fillText(part.label, ax + 27, ay - 11);
      }
    }
    ctx.globalAlpha = 1;
  };

  let last = 0;
  const loop = (t: number) => {
    if (t - last > 33) {
      last = t;
      draw(t);
    }
    if (!still.matches) requestAnimationFrame(loop);
  };

  resize();
  addEventListener("resize", () => { resize(); draw(performance.now()); });
  if (still.matches) {
    shown = apart();
    draw(0);
    addEventListener("scroll", () => { shown = apart(); draw(0); }, { passive: true });
  } else {
    requestAnimationFrame(loop);
  }
</script>
