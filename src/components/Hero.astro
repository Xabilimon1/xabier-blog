---
import Shapes from "./decorations/Shapes.astro";
---

<section id="home" class="relative min-h-screen flex items-center justify-center px-6 py-20">
  <Shapes />

  <div class="relative max-w-4xl mx-auto text-center">
    <!-- Avatar circle -->
    <div class="flex justify-center mb-8">
      <div class="w-32 h-32 rounded-full bg-gradient-to-br from-coral to-purple flex items-center justify-center text-white text-5xl font-display font-bold shadow-soft" style="background: linear-gradient(135deg, #FF5757, #A78BFA);">
        X
      </div>
    </div>

    <!-- Name + role -->
    <h1 class="text-5xl md:text-6xl font-bold mb-4 text-[var(--color-ink)]">
      Xabier Ariznabarreta
    </h1>
    <p class="text-xl text-[var(--color-mute)] mb-8">
      19yo · pivoting from production agents to research
    </p>

    <!-- Social links -->
    <div class="flex justify-center gap-5 mb-10">
      <a href="https://github.com/Xabilimon1" class="text-[var(--color-ink)] hover:text-[var(--color-coral)] transition-colors text-2xl" aria-label="GitHub" target="_blank" rel="noopener">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55v-1.92c-3.2.7-3.87-1.54-3.87-1.54-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.34.96.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18.92-.26 1.9-.39 2.88-.39.98 0 1.96.13 2.88.39 2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.4-5.26 5.68.41.36.78 1.07.78 2.15v3.19c0 .31.21.66.79.55C20.21 21.39 23.5 17.08 23.5 12c0-6.35-5.15-11.5-11.5-11.5z"/>
        </svg>
      </a>
      <a href="https://twitter.com/" class="text-[var(--color-ink)] hover:text-[var(--color-coral)] transition-colors" aria-label="X / Twitter" target="_blank" rel="noopener">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
      <a href="mailto:xabier.ariznabarreta@gmail.com" class="text-[var(--color-ink)] hover:text-[var(--color-coral)] transition-colors" aria-label="Email">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="5" width="18" height="14" rx="2"/>
          <path d="M3 7l9 6 9-6"/>
        </svg>
      </a>
    </div>

    <!-- CTA -->
    <a href="#about" class="pill-cta">
      Read my work
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>

    <!-- Scroll indicator -->
    <div class="mt-16 flex flex-col items-center text-[var(--color-mute)] text-sm">
      <span>Scroll Down</span>
      <svg width="20" height="20" viewBox="0 0 20 20" class="mt-2 animate-bounce" fill="none">
        <path d="M10 3v14M5 12l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </div>
</section>
