---
// Fig. 0 on the home page: an LLM agent drawn as an exploded view, one slab per
// part of the harness the ablation study removes one at a time, plus the model.
// Drawn bottom slab first so each slab above hides the one below it.
const parts = [
  { label: "prompt structure", note: "where SAM broke" },
  { label: "tool selection" },
  { label: "retry policy" },
  { label: "context management" },
  { label: "the model", hatch: true },
];
const top = 46;
const gap = 54;
const cx = 110;
const hw = 88; // half width of a slab
const hh = 28; // half height of a slab's top face
const t = 9; // slab thickness
const ys = parts.map((_, i) => top + i * gap);
---

<figure class="fig0">
  <svg viewBox="0 0 420 320" role="img" aria-labelledby="fig0-title">
    <title id="fig0-title">An LLM agent drawn as an exploded view: prompt structure, tool selection, retry policy, context management and the model, stacked and labelled.</title>
    <defs>
      <pattern id="hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="7" class="hatch-line" />
      </pattern>
    </defs>

    <line class="centre" x1={cx} y1="8" x2={cx} y2={ys[ys.length - 1] + hh + t + 14} />

    {[...parts].map((p, i) => ({ ...p, y: ys[i], n: i + 1 })).reverse().map((p) => (
      <g class="slab">
        <path class="side" d={`M${cx - hw},${p.y} L${cx},${p.y + hh} L${cx},${p.y + hh + t} L${cx - hw},${p.y + t} Z`} />
        <path class="side side-dark" d={`M${cx},${p.y + hh} L${cx + hw},${p.y} L${cx + hw},${p.y + t} L${cx},${p.y + hh + t} Z`} />
        <path class={p.hatch ? "face face-hatch" : "face"} d={`M${cx - hw},${p.y} L${cx},${p.y - hh} L${cx + hw},${p.y} L${cx},${p.y + hh} Z`} />
      </g>
    ))}

    {parts.map((p, i) => (
      <g class="callout">
        <line class="leader" x1={cx + hw - 4} y1={ys[i] + 2} x2="238" y2={ys[i] + 2} />
        <circle class="dot" cx={cx + hw - 4} cy={ys[i] + 2} r="1.8" />
        <circle class="ring" cx="250" cy={ys[i] + 2} r="11" />
        <text class="ring-no" x="250" y={ys[i] + 6.5} text-anchor="middle">{i + 1}</text>
        <text class="label" x="268" y={ys[i] + 6.5}>{p.label}</text>
        {p.note && <text class="note" x="268" y={ys[i] + 23}>{p.note}</text>}
      </g>
    ))}
  </svg>
  <figcaption>
    <span class="fig-no">Fig. 00</span>
    An LLM agent, exploded: the harness parts my ablation study removes one at a time, and the model under them.
  </figcaption>
</figure>
