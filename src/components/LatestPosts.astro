---

<section id="posts" class="relative px-6 py-24 max-w-6xl mx-auto">
  <div class="flex items-baseline justify-between mb-12">
    <h2 class="text-4xl font-bold">Latest Posts</h2>
    <a href="/posts" class="text-sm text-[var(--color-coral)] font-semibold hover:underline">
      View all →
    </a>
  </div>

  <div class="grid md:grid-cols-3 gap-6">
    {posts.map((post) => (
      <a href={post.slug} class="card group hover:shadow-soft transition-shadow flex flex-col">
        <!-- Illustrated placeholder -->
        <div class="aspect-video rounded-2xl mb-4 flex items-center justify-center" style="background: linear-gradient(135deg, #FFF5F5, #FCE7F3);">
          <div class="text-5xl opacity-30">{post.tag === "Meta" ? "💭" : post.tag === "Tutorial" ? "📘" : "🔬"}</div>
        </div>

        <span class="chip self-start mb-3" style={`background-color: ${post.tagColor}20; color: ${post.tagColor};`}>
          {post.tag}
        </span>

        <h3 class="text-lg font-bold mb-2 group-hover:text-[var(--color-coral)] transition-colors leading-snug">
          {post.title}
        </h3>

        <p class="text-sm text-[var(--color-mute)] mb-4 leading-relaxed flex-1">
          {post.description}
        </p>

        <div class="text-xs text-[var(--color-mute)] uppercase tracking-wider">
          {post.date}
        </div>
      </a>
    ))}
  </div>
</section>
