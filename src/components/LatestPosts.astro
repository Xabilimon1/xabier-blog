const posts = [
  {
    tag: "Meta",
    tagColor: "#FF5757",
    title: "Why I'm pivoting from production agents to research at 19",
    date: "Coming soon",
    description: "The honest reasoning, the failed flagships, the decision to optimize for research output.",
    slug: "/posts/why-pivoting-to-research",
  },
  {
    tag: "Tutorial",
    tagColor: "#A78BFA",
    title: "Demystifying evals: what I learned from Anthropic's paper",
    date: "Coming soon",
    description: "Notes + open questions after reading the eval methodology post end-to-end.",
    slug: "/posts/demystifying-evals-notes",
  },
  {
    tag: "Research",
    tagColor: "#F472B6",
    title: "Infrastructure noise as the dominant variable",
